# Copy to .env and adjust. Never commit the real .env (see docs/16-security.md SEC-09).

ARVEXO_ENVIRONMENT=demo
ARVEXO_AUTH_MODE=demo

POSTGRES_USER=arvexo
POSTGRES_PASSWORD=arvexo
POSTGRES_DB=arvexo_radar
ARVEXO_DATABASE_URL=postgresql+asyncpg://arvexo:arvexo@db:5432/arvexo_radar

ARVEXO_STORAGE_PATH=/data/storage

ARVEXO_LLM_PROVIDER_MODE=mock
# Only needed when ARVEXO_LLM_PROVIDER_MODE=bothub:
ARVEXO_BOTHUB_API_KEY=
ARVEXO_BOTHUB_BASE_URL=
ARVEXO_BOTHUB_MODEL=gemini-flash

# OpenAI-compatible proxy. The base URL includes the API version prefix.
ARVEXO_LLM_PROXY_BASE_URL=https://api.openai.com/v1
ARVEXO_LLM_PROXY_API_KEY=
ARVEXO_LLM_PROXY_TIMEOUT_SECONDS=60
# Required in production. Generate a long random value and never expose it to clients.
ARVEXO_ANALYTICS_USER_HASH_SALT=change-this-to-a-long-random-server-side-secret
ARVEXO_ANALYTICS_CURRENCY=USD

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Only needed on the deploy server, for docker-compose.prod.yml
# (see .github/workflows/cd.yml / docs/22-ci-cd.md). Leave unset locally.
API_IMAGE=
WEB_IMAGE=

# Production-only (docker-compose.prod.yml). Loopback host ports behind
# nginx — 80/443/3000/8000 already taken by other services on the box.
API_HOST_PORT=38000
WEB_HOST_PORT=38080

# Production-only. Public origin fronted by nginx; must match
# NEXT_PUBLIC_API_BASE_URL below and the nginx server_name.
# ARVEXO_CORS_ORIGINS=["https://radar.arvexo.ru"]
# NEXT_PUBLIC_API_BASE_URL=https://radar.arvexo.ru/api/v1
